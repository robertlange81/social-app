PORT=4000
JWT_SECRET=change_me_dev_secret
CORS_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
# Optionaler HTTPS-Webhook. Erhält JSON: { to, template, link }
EMAIL_WEBHOOK_URL=
# Kommagetrennte E-Mail-Adressen mit Zugriff auf /api/moderation
ADMIN_EMAILS=
NODE_ENV=development
# Hinter genau einem vertrauenswürdigen Reverse Proxy auf 1 setzen:
TRUST_PROXY=0
# Öffentliche Pflichtangaben für die Datenschutzerklärung. In Produktion ausfüllen.
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_LOCATION=Deutschland
LEGAL_EMAIL_PROVIDER=
LEGAL_PROCESSORS=
LEGAL_LOG_RETENTION_DAYS=14
LEGAL_BACKUP_RETENTION_DAYS=30
PRIVACY_REQUEST_EMAIL=lange@web-app-it.de
# Optional, besonders für isolierte Tests:
# DB_PATH=/tmp/herzklang-test.db
